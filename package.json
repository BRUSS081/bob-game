{
  "name": "bob-game",
  "private": true,
  "version": "0.1.0",
  "description": "BOB - one-button pixel art water sports endless runner",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "reference": "node scripts/render-reference.ts",
    "icons": "node scripts/render-icons.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
